# Copy to .streamlit/secrets.toml (never commit that file) and fill in.
# On Streamlit Community Cloud, paste the same text into App settings -> Secrets.

# Optional AI advisory. Any OpenAI-compatible provider works; leave this
# section out (or any field empty) and the app just skips the advisory.
[llm]
# Groq (free tier, no card): create a key at https://console.groq.com/keys
base_url = "https://api.groq.com/openai/v1"
# Pick a current chat model id from your provider's console / models list
model    = ""
api_key  = ""

# Google Gemini (free tier via Google AI Studio) instead:
# base_url = "https://generativelanguage.googleapis.com/v1beta/openai/"
# model    = ""
# api_key  = ""
